<Window x:Class="KonyvekFeladat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KonyvekFeladat"
        mc:Ignorable="d"
        Title="Könyvek" Height="500" Width="850">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <Button Content="Könyvek betöltése" Height="28" Margin="0,0,0,5" Click="BtnBetoltes_Click"/>
            <Button Content="Hány könyv van?" Height="28" Margin="0,0,0,5" Click="BtnHanyKonyv_Click"/>
            <Button Content="Melyik a leghosszabb könyv?" Height="28" Margin="0,0,0,5" Click="BtnLeghosszabb_Click"/>
            <Button Content="Átlagos oldalszám" Height="28" Margin="0,0,0,5" Click="BtnAtlag_Click"/>
            <Button Content="Csak elérhető könyvek" Height="28" Margin="0,0,0,5" Click="BtnElerheto_Click"/>
            <Button Content="Csak címek listája" Height="28" Margin="0,0,0,5" Click="BtnCimek_Click"/>
            <Button Content="Rendezés szerző szerint" Height="28" Margin="0,0,0,10" Click="BtnRendezes_Click"/>

            <ProgressBar x:Name="pbHaladas" Height="20" Value="0" Maximum="100"/>
        </StackPanel>

       
        <DataGrid x:Name="dgKonyvek" Grid.Column="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cím" Binding="{Binding Cim}" Width="*" />
                <DataGridTextColumn Header="Szerző" Binding="{Binding Szerzo}" Width="120" />
                <DataGridTextColumn Header="Oldalszám" Binding="{Binding Oldalszam}" Width="80" />
                <DataGridTextColumn Header="Műfaj" Binding="{Binding Mufaj}" Width="90" />
                <DataGridCheckBoxColumn Header="Elérhető" Binding="{Binding Elerheto}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
